{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 2,
            "right": 4
        }
    },
    "display": {
        "separator": " ➜  "
    },
    "modules": [
        "break",
        { "type": "os", "key": " OS", "keyColor": "blue" },
        { "type": "kernel", "key": " Kernel", "keyColor": "blue" },
        { "type": "packages", "key": "󰏖 Packages", "keyColor": "blue" },
        "break",
        { "type": "wm", "key": " WM", "keyColor": "yellow" },
        { "type": "terminal", "key": " Term", "keyColor": "yellow" },
        { "type": "shell", "key": " Shell", "keyColor": "yellow" },
        "break",
        { "type": "cpu", "key": " CPU", "keyColor": "green" },
        { "type": "memory", "key": " Memory", "keyColor": "green" },
        { "type": "uptime", "key": "󰅐 Uptime", "keyColor": "green" },
        "break",
        "colors"
    ]
}
