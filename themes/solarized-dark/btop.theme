#Bashtop / btop theme: Solarized Dark
#Colors based on Ethan Schoonover's Solarized palette

theme[main_bg]="#002b36"
theme[main_fg]="#839496"
theme[title]="#93a1a1"
theme[hi_fg]="#268bd2"
theme[selected_bg]="#073642"
theme[selected_fg]="#eee8d5"
theme[inactive_fg]="#586e75"
theme[graph_text]="#586e75"
theme[proc_misc]="#2aa198"

# Box outlines
theme[cpu_box]="#073642"
theme[mem_box]="#073642"
theme[net_box]="#073642"
theme[proc_box]="#073642"
theme[div_line]="#073642"

# Temperature graph
theme[temp_start]="#859900"
theme[temp_mid]="#b58900"
theme[temp_end]="#dc322f"

# CPU graph
theme[cpu_start]="#859900"
theme[cpu_mid]="#b58900"
theme[cpu_end]="#dc322f"

# Mem/Disk meters
theme[free_start]="#859900"
theme[free_mid]="#b58900"
theme[free_end]="#dc322f"

theme[cached_start]="#2aa198"
theme[cached_mid]="#268bd2"
theme[cached_end]="#6c71c4"

theme[available_start]="#859900"
theme[available_mid]="#b58900"
theme[available_end]="#dc322f"

theme[used_start]="#859900"
theme[used_mid]="#b58900"
theme[used_end]="#dc322f"

# Download / Upload traffic
theme[download_start]="#2aa198"
theme[download_mid]="#268bd2"
theme[download_end]="#6c71c4"

theme[upload_start]="#b58900"
theme[upload_mid]="#cb4b16"
theme[upload_end]="#dc322f"

# Process box
theme[process_start]="#2aa198"
