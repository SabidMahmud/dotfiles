#!/usr/bin/env bash
# sway-lock — Screen locker wrapper with hyprlock and swaylock fallback

set -uo pipefail

# Avoid launching multiple locker instances if already locked
if pidof hyprlock >/dev/null 2>&1 || pidof swaylock >/dev/null 2>&1; then
    exit 0
fi

if command -v hyprlock >/dev/null 2>&1; then
    exec hyprlock "$@"
elif command -v swaylock >/dev/null 2>&1; then
    exec swaylock -f -c 000000 "$@"
else
    notify-send -u critical "Screen Lock" "No lock screen utility found (install hyprlock or swaylock)." 2>/dev/null
    exit 1
fi
