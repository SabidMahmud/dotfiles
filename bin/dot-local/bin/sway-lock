#!/usr/bin/env python3
"""Return after the compositor confirms a lock; supervise until unlock."""

import argparse
import fcntl
import hashlib
import os
from pathlib import Path
import re
import selectors
import shutil
import socket
import subprocess
import sys
import time


ANSI = re.compile(r"\x1b\[[0-9;]*m")


def stop(process):
    if process.poll() is None:
        try:
            process.terminate()
        except ProcessLookupError:
            process.wait()
            return
        try:
            process.wait(timeout=0.3)
        except subprocess.TimeoutExpired:
            try:
                process.kill()
            except ProcessLookupError:
                pass
            process.wait()


def reply(client, message):
    try:
        client.sendall(message.encode() + b"\n")
    except OSError:
        pass
    finally:
        client.close()


def supervise(endpoint, lock_fd, config):
    # Retain the flock for the entire lock lifetime, including recovery.
    os.setsid()
    null = os.open(os.devnull, os.O_RDWR)
    for descriptor in (0, 1, 2):
        os.dup2(null, descriptor)
    if null > 2:
        os.close(null)
    server = socket.socket(socket.AF_UNIX)
    selector = selectors.DefaultSelector()
    clients = []
    process = None
    ready = False
    try:
        endpoint.unlink(missing_ok=True)
        server.bind(str(endpoint))
        os.chmod(endpoint, 0o600)
        server.listen(16)
        # Connect a caller before starting: even an immediate failure must
        # have a recipient for its error result.
        server.settimeout(5)
        client, _ = server.accept()
        clients.append(client)
        server.setblocking(False)
        selector.register(server, selectors.EVENT_READ, "client")

        for locker, timeout in (("hyprlock", 2.5), ("swaylock", 1.5)):
            binary = shutil.which(locker)
            if not binary:
                continue
            ready_fd = None
            if locker == "hyprlock":
                # 0.9.6 logs this only from the compositor's locked callback.
                # Line buffering exposes the acknowledgement through a pipe.
                stdbuf = shutil.which("stdbuf")
                if not stdbuf:
                    continue
                command = [stdbuf, "-oL", "-eL", binary, "--grace", "0"]
                if config:
                    command += ["--config", config]
                inherited = ()
            else:
                ready_fd, write_fd = os.pipe()
                command = [binary, "-c", "000000", "--ready-fd", str(write_fd)]
                inherited = (write_fd,)
            try:
                process = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                           pass_fds=inherited)
            except OSError:
                if ready_fd is not None:
                    os.close(ready_fd)
                    os.close(write_fd)
                continue
            if ready_fd is not None:
                os.close(write_fd)
                selector.register(ready_fd, selectors.EVENT_READ, "ready")
            selector.register(process.stdout, selectors.EVENT_READ, "output")
            confirmed = False
            output = b""
            deadline = time.monotonic() + timeout
            while True:
                for key, _ in selector.select(1.0 if confirmed else 0.05):
                    if key.data == "client":
                        client, _ = server.accept()
                        client.settimeout(0.5)
                        if ready and process.poll() is None:
                            reply(client, "locked")
                        else:
                            clients.append(client)
                    else:
                        chunk = os.read(key.fd, 65536)
                        if not chunk:
                            selector.unregister(key.fileobj)
                        elif key.data == "ready":
                            confirmed = True
                        elif not confirmed and locker == "hyprlock":
                            output = (output + chunk)[-65536:]
                            lines = output.split(b"\n")
                            output = lines.pop()
                            confirmed = any(ANSI.sub("", line.decode(errors="replace")).strip()
                                            .endswith("onLockLocked called") for line in lines)
                        # Drain and discard normal output. Never persist
                        # authentication or keyboard diagnostics.
                status = process.poll()
                if confirmed and not ready and status is None:
                    ready = True
                    for client in clients:
                        reply(client, "locked")
                    clients.clear()
                if status is not None:
                    break
                if not confirmed and time.monotonic() >= deadline:
                    stop(process)
                    break
            if process.stdout in [key.fileobj for key in selector.get_map().values()]:
                selector.unregister(process.stdout)
            process.stdout.close()
            if ready_fd is not None:
                if ready_fd in selector.get_map():
                    selector.unregister(ready_fd)
                os.close(ready_fd)
            if confirmed and process.returncode == 0:
                return  # Normal unlock: do not immediately lock again.
            # Early exit (even status 0), timeout or crash tries swaylock.
            # During recovery, new callers wait for its acknowledgement.
            ready = False
        for client in clients:
            reply(client, "error: neither locker confirmed the session lock")
        clients.clear()
    finally:
        for client in clients:
            reply(client, "error: lock launcher failed")
        if process is not None and process.poll() is None and not ready:
            stop(process)
        selector.close()
        server.close()
        endpoint.unlink(missing_ok=True)
        os.close(lock_fd)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-c", "--config", help="Hyprlock config file (fallback uses swaylock defaults)")
    args = parser.parse_args()
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
    if not runtime.is_absolute() or not runtime.is_dir() or runtime.stat().st_uid != os.getuid():
        raise RuntimeError("A user-owned XDG_RUNTIME_DIR is required to start the screen locker.")
    directory = runtime / "dotfiles-lock"
    directory.mkdir(mode=0o700, exist_ok=True)
    if directory.is_symlink() or directory.stat().st_uid != os.getuid():
        raise RuntimeError("The screen-lock runtime directory is not owned by this user.")
    os.chmod(directory, 0o700)
    display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
    name = hashlib.sha256(display.encode()).hexdigest()[:12]
    endpoint = directory / (name + ".sock")
    lock_fd = os.open(directory / (name + ".lock"), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(lock_fd)
    else:
        pid = os.fork()
        if pid == 0:
            try:
                supervise(endpoint, lock_fd, args.config)
            finally:
                os._exit(0)
        os.close(lock_fd)

    deadline = time.monotonic() + 6
    while time.monotonic() < deadline:
        with socket.socket(socket.AF_UNIX) as client:
            client.settimeout(max(0.1, deadline - time.monotonic()))
            try:
                client.connect(str(endpoint))
            except (FileNotFoundError, ConnectionRefusedError):
                time.sleep(0.02)
                continue
            with client.makefile("rb") as stream:
                response = stream.readline(256).decode().strip()
            if response == "locked":
                return 0
            raise RuntimeError(response or "Lock launcher exited before confirming the session lock.")
    raise RuntimeError("Timed out waiting for the screen lock to be confirmed.")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as error:
        message = str(error)
        print("sway-lock: " + message, file=sys.stderr)
        if shutil.which("notify-send"):
            try:
                subprocess.run(["notify-send", "-u", "critical", "Screen Lock", message],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                pass
        sys.exit(1)
