#!/usr/bin/env python3
"""
wallpaper-preview: Fast terminal previewer for images in fzf.
Supports WezTerm imgcat, Chafa, and universal ANSI truecolor half-blocks via PIL.
"""

import os
import shutil
import subprocess
import sys

def main():
    if len(sys.argv) < 2:
        sys.exit(0)

    # Handle both: wallpaper-preview <dir> <filename> or wallpaper-preview <path>
    if len(sys.argv) >= 3:
        arg1 = sys.argv[1].strip().strip("'\"")
        arg2 = sys.argv[2].strip().strip("'\"")
        image_path = os.path.join(arg1, arg2)
    else:
        raw = sys.argv[1].strip().strip("'\"")
        # Strip internal quotes if fzf injected them into "$DIR/{}"
        clean_dir = os.path.dirname(raw).replace("'", "").replace('"', "")
        clean_base = os.path.basename(raw).replace("'", "").replace('"', "")
        image_path = os.path.join(clean_dir, clean_base)

    if not os.path.exists(image_path):
        print(f"File not found: {image_path}")
        sys.exit(0)

    # If a theme directory is passed instead of an image, find its background/wallpaper
    if os.path.isdir(image_path):
        candidates = []
        wp_dir = os.path.join(image_path, "wallpapers")
        if os.path.isdir(wp_dir):
            for f in sorted(os.listdir(wp_dir)):
                if any(f.lower().endswith(ext) for ext in (".png", ".jpg", ".jpeg", ".webp")):
                    candidates.append(os.path.join(wp_dir, f))
        for f in os.listdir(image_path):
            if f.startswith("background.") and any(f.lower().endswith(ext) for ext in (".png", ".jpg", ".jpeg", ".webp")):
                candidates.insert(0, os.path.join(image_path, f))
        if candidates:
            image_path = candidates[0]
        else:
            print(f"No wallpaper found in {image_path}")
            sys.exit(0)

    # Get preview dimensions from fzf environment or terminal
    try:
        cols = int(os.environ.get("FZF_PREVIEW_COLUMNS", 0))
    except ValueError:
        cols = 0
    try:
        lines = int(os.environ.get("FZF_PREVIEW_LINES", 0))
    except ValueError:
        lines = 0

    if cols <= 0 or lines <= 0:
        ts = shutil.get_terminal_size((80, 24))
        cols = cols or ts.columns // 2
        lines = lines or ts.lines

    # 1. If WezTerm/Kitty/Zellij is detected, output Kitty image protocol.
    # (Disabled because fzf + Zellij aggressively overwrites the image, leaving an empty box)
    # if "WEZTERM_PANE" in os.environ or os.environ.get("TERM_PROGRAM") == "WezTerm" or "ZELLIJ" in os.environ or "KITTY_WINDOW_ID" in os.environ:
    #     try:
    #         import base64
    #         import io
    #         from PIL import Image
    # 
    #         im = Image.open(image_path).convert("RGB")
    #         im.thumbnail((800, 800), Image.Resampling.LANCZOS)
    #         buf = io.BytesIO()
    #         im.save(buf, format="PNG")
    #         b64 = base64.b64encode(buf.getvalue()).decode("ascii")
    #         
    #         fname = os.path.basename(image_path)
    #         sys.stdout.write(f"\033[1;33m{fname}\033[0m\n")
    #         
    #         chunk_size = 4096
    #         for i in range(0, len(b64), chunk_size):
    #             chunk = b64[i:i+chunk_size]
    #             m = 0 if i + chunk_size >= len(b64) else 1
    #             if i == 0:
    #                 sys.stdout.write(f"\033_Ga=T,f=100,m={m};{chunk}\033\\")
    #             else:
    #                 sys.stdout.write(f"\033_Gm={m};{chunk}\033\\")
    #         sys.stdout.write("\n")
    #         sys.stdout.flush()
    #         sys.exit(0)
    #     except Exception:
    #         pass

    # 2. If chafa is available, use it
    if shutil.which("chafa"):
        try:
            res = subprocess.run(
                ["chafa", f"--size={cols}x{lines - 2}", image_path],
                check=False
            )
            if res.returncode == 0:
                sys.exit(0)
        except Exception:
            pass

    # 2. Universal ANSI Truecolor Half-Block renderer via PIL
    try:
        from PIL import Image

        im = Image.open(image_path).convert("RGB")
        orig_w, orig_h = im.size

        # Reserve 2 lines for title and file info
        avail_lines = max(4, lines - 2)
        avail_cols = max(10, cols - 2)

        # In half-block rendering, each cell represents 1 width x 2 height pixels
        eff_target_h_pixels = avail_lines * 2
        scale_w = avail_cols / orig_w
        scale_h = eff_target_h_pixels / orig_h
        scale = min(scale_w, scale_h)

        target_w = max(1, int(orig_w * scale))
        target_h = max(2, int(orig_h * scale))
        if target_h % 2 != 0:
            target_h += 1

        im = im.resize((target_w, target_h), Image.Resampling.BILINEAR)
        pix = im.load()

        fname = os.path.basename(image_path)
        size_kb = os.path.getsize(image_path) // 1024
        print(f"\033[1;33m{fname}\033[0m \033[90m({orig_w}x{orig_h}, {size_kb} KB)\033[0m\n")

        for y in range(0, target_h, 2):
            row = []
            for x in range(target_w):
                r1, g1, b1 = pix[x, y]
                r2, g2, b2 = pix[x, y + 1] if y + 1 < target_h else (0, 0, 0)
                row.append(f"\033[38;2;{r1};{g1};{b1}m\033[48;2;{r2};{g2};{b2}m▀")
            row.append("\033[0m")
            print("".join(row))

    except Exception as e:
        print(f"Preview unavailable: {e}")

if __name__ == "__main__":
    main()
