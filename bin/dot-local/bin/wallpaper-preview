#!/usr/bin/env python3
"""
wallpaper-preview: Fast terminal previewer for images in fzf.
Requires: chafa (sudo apt install chafa / pacman -S chafa)
"""

import os
import shutil
import sys

def main():
    if len(sys.argv) < 2:
        sys.exit(0)

    # Handle both: wallpaper-preview <dir> <filename> or wallpaper-preview <path>
    if len(sys.argv) >= 3:
        arg1 = sys.argv[1].strip().strip("'\"")
        arg2 = sys.argv[2].strip().strip("'\"")
        image_path = os.path.join(arg1, arg2)
    else:
        raw = sys.argv[1].strip().strip("'\"")
        # Strip internal quotes if fzf injected them into "$DIR/{}"
        clean_dir = os.path.dirname(raw).replace("'", "").replace('"', "")
        clean_base = os.path.basename(raw).replace("'", "").replace('"', "")
        image_path = os.path.join(clean_dir, clean_base)

    if not os.path.exists(image_path):
        print(f"File not found: {image_path}")
        sys.exit(0)

    # If a theme directory is passed instead of an image, find its background/wallpaper
    if os.path.isdir(image_path):
        candidates = []
        wp_dir = os.path.join(image_path, "wallpapers")
        if os.path.isdir(wp_dir):
            for f in sorted(os.listdir(wp_dir)):
                if any(f.lower().endswith(ext) for ext in (".png", ".jpg", ".jpeg", ".webp")):
                    candidates.append(os.path.join(wp_dir, f))
        for f in os.listdir(image_path):
            if f.startswith("background.") and any(f.lower().endswith(ext) for ext in (".png", ".jpg", ".jpeg", ".webp")):
                candidates.insert(0, os.path.join(image_path, f))
        if candidates:
            image_path = candidates[0]
        else:
            print(f"No wallpaper found in {image_path}")
            sys.exit(0)

    # Get preview dimensions from fzf environment or terminal
    try:
        cols = int(os.environ.get("FZF_PREVIEW_COLUMNS", 0))
    except ValueError:
        cols = 0
    try:
        lines = int(os.environ.get("FZF_PREVIEW_LINES", 0))
    except ValueError:
        lines = 0

    if cols <= 0 or lines <= 0:
        ts = shutil.get_terminal_size((80, 24))
        cols = cols or ts.columns // 2
        lines = lines or ts.lines


    # 2. If chafa is available, use it (replace Python process for efficiency)
    if shutil.which("chafa"):
        chafa_lines = max(2, lines - 2)
        try:
            os.execvp("chafa", ["chafa", f"--size={cols}x{chafa_lines}", image_path])
        except Exception:
            pass

    print("\033[90mPreview unavailable — install chafa for image previews:\033[0m")
    print("  sudo apt install chafa")
    print("  sudo pacman -S chafa")

if __name__ == "__main__":
    main()
