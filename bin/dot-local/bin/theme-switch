#!/usr/bin/env bash
# theme-switch — Unified Linux Theme Switcher

set -e

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
THEMES_DIR="$DOTFILES_DIR/themes"

PICKER_UI=auto
case "${1:-}" in
    --cli) PICKER_UI=cli; shift ;;
    --gui) PICKER_UI=gui; shift ;;
    --help|-h)
        echo 'Usage: theme-switch [--gui|--cli] [THEME [IMAGE]|wallpaper [IMAGE]|browse]'
        echo 'Without arguments, open the theme gallery. Use wallpaper for the active theme.'
        echo 'Use browse to choose from all wallpapers and apply the matching preset.'
        exit 0
        ;;
esac

if [ ! -d "$THEMES_DIR" ]; then
    echo "Error: Themes directory not found at $THEMES_DIR"
    exit 1
fi

# Only interactive selection opens a gallery; direct theme/image commands stay scriptable.
PICKER_MODE=''
case "${1:-}" in
    '') PICKER_MODE=themes ;;
    browse|all-wallpapers) PICKER_MODE=all-wallpapers ;;
    -w|--wallpaper|wallpaper|wallpapers)
        if [ -z "${2:-}" ]; then PICKER_MODE=wallpapers; fi
        ;;
esac
if [ -n "$PICKER_MODE" ] && [ "$PICKER_UI" != cli ]; then
    if [ "$PICKER_UI" = gui ] || { { [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; } && { command -v qs &>/dev/null || command -v quickshell &>/dev/null; }; }; then
        exec python3 "$DOTFILES_DIR/bin/dot-local/bin/theme-picker" "$PICKER_MODE"
    fi
    # A Sway shortcut has no terminal attached. Open the CLI fallback in a terminal.
    if [ ! -t 0 ] && { [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; }; then
        if command -v kitty &>/dev/null; then
            exec kitty -e bash "$DOTFILES_DIR/bin/dot-local/bin/theme-switch" --cli "$@"
        elif command -v foot &>/dev/null; then
            exec foot bash "$DOTFILES_DIR/bin/dot-local/bin/theme-switch" --cli "$@"
        elif command -v alacritty &>/dev/null; then
            exec alacritty -e bash "$DOTFILES_DIR/bin/dot-local/bin/theme-switch" --cli "$@"
        fi
    fi
fi

if [ "$PICKER_MODE" = all-wallpapers ]; then
    exec python3 "$DOTFILES_DIR/bin/dot-local/bin/theme-picker" all-wallpapers --choose
fi

resolve_wallpaper() {
    local THEME_DIR="$1" REQUESTED="$2" RESOLVED CANDIDATE
    RESOLVED=$(realpath -e -- "$REQUESTED") || return 1
    while IFS= read -r -d '' CANDIDATE; do
        if [ "$(realpath -- "$CANDIDATE")" = "$RESOLVED" ]; then
            printf '%s\n' "$RESOLVED"
            return 0
        fi
    done < <(find "$THEME_DIR" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0)
    echo "Error: Wallpaper does not belong to theme '$(basename "$THEME_DIR")'." >&2
    return 1
}

apply_wallpaper() {
    local WALLPAPER="$1"
    local THEME="$2"
    
    if [ -z "$WALLPAPER" ] || [ ! -f "$WALLPAPER" ]; then
        return 0
    fi
    
    echo "  -> Setting wallpaper: $(basename "$WALLPAPER")..."

    if command -v gsettings &>/dev/null; then
        gsettings set org.gnome.desktop.background picture-uri "file://$WALLPAPER"
        gsettings set org.gnome.desktop.background picture-uri-dark "file://$WALLPAPER"
        gsettings set org.gnome.desktop.background picture-options 'zoom'
        local COLOR_SCHEME='prefer-dark'
        local GTK_SUFFIX='-dark'
        if [ "$THEME" = 'catppuccin-latte' ] || [ -f "$THEMES_DIR/$THEME/light.mode" ]; then
            COLOR_SCHEME='prefer-light'
            GTK_SUFFIX=''
        fi
        gsettings set org.gnome.desktop.interface color-scheme "$COLOR_SCHEME"

        case "$THEME" in
            omarchy-*)
                ACCENT=$(cat "$THEMES_DIR/$THEME/gtk-accent" 2>/dev/null || true)
                case "$ACCENT" in
                    blue|teal|green|yellow|orange|red|pink|purple|slate) ;;
                    *) ACCENT='' ;;
                esac
                ;;
            catppuccin|catppuccin-latte|catppuccin-frappe|catppuccin-macchiato|catppuccin-mocha)
                         ACCENT="magenta" ;;
            everforest)  ACCENT="bark" ;;
            gruvbox)     ACCENT="sage" ;;
            kanagawa)    ACCENT="purple" ;;
            matte-black) ACCENT="orange" ;;
            nord)        ACCENT="blue" ;;
            osaka-jade)  ACCENT="green" ;;
            ristretto)   ACCENT="grey" ;;
            rose-pine)   ACCENT="red" ;;
            solarized-dark) ACCENT="teal" ;;
            tokyo-night) ACCENT="purple" ;;
            *)           ACCENT="" ;;
        esac

        if [ -n "$ACCENT" ]; then
            gsettings set org.gnome.desktop.interface accent-color "$ACCENT" 2>/dev/null || true
            gsettings set org.gnome.desktop.interface gtk-theme "Yaru-$ACCENT$GTK_SUFFIX" 2>/dev/null || true
            gsettings set org.gnome.desktop.interface icon-theme "Yaru-$ACCENT" 2>/dev/null || true
        fi
    fi

    if command -v swww &>/dev/null; then
        swww img "$WALLPAPER" --transition-type fade 2>/dev/null || true
    elif command -v hyprctl &>/dev/null && command -v hyprpaper &>/dev/null; then
        hyprctl hyprpaper preload "$WALLPAPER" 2>/dev/null || true
        hyprctl hyprpaper wallpaper ",$WALLPAPER" 2>/dev/null || true
    fi

    if command -v swaymsg &>/dev/null && command -v swaybg &>/dev/null; then
        pkill swaybg 2>/dev/null || true
        swaybg -i "$WALLPAPER" -m fill &>/dev/null &
    fi

    if [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
        if command -v feh &>/dev/null; then
            feh --bg-fill "$WALLPAPER" 2>/dev/null || true
        elif command -v nitrogen &>/dev/null; then
            nitrogen --set-zoom-fill "$WALLPAPER" --save 2>/dev/null || true
        fi
    fi
}

if [[ "${1:-}" == "-w" || "${1:-}" == "--wallpaper" || "${1:-}" == "wallpaper" || "${1:-}" == "wallpapers" ]]; then
    if [ ! -f "$HOME/.config/current-theme" ]; then
        echo "Error: No theme currently active. Switch to a theme first."
        exit 1
    fi
    THEME=$(cat "$HOME/.config/current-theme")
    SELECTED_DIR="$THEMES_DIR/$THEME"
    WALLPAPER_DIR="$SELECTED_DIR/wallpapers"

    if [ -n "${2:-}" ]; then
        WALLPAPER=$(resolve_wallpaper "$SELECTED_DIR" "$2") || exit 1
        apply_wallpaper "$WALLPAPER" "$THEME"
        echo "$WALLPAPER" > "$HOME/.config/current-wallpaper-$THEME"
        echo "==> Successfully switched wallpaper to $(basename "$WALLPAPER")!"
        exit 0
    fi
    
    if [ ! -d "$WALLPAPER_DIR" ]; then
        echo "No 'wallpapers' directory found for theme '$THEME'."
        WALLPAPER=$(find "$SELECTED_DIR" -maxdepth 1 -name "background.*" | head -n 1)
        if [ -n "$WALLPAPER" ] && [ -f "$WALLPAPER" ]; then
            apply_wallpaper "$WALLPAPER" "$THEME"
            echo "$WALLPAPER" > "$HOME/.config/current-wallpaper-$THEME"
            exit 0
        else
            echo "Error: No wallpapers available for this theme."
            exit 1
        fi
    fi
    
    mapfile -t AVAILABLE_WALLPAPERS < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.jpeg" -o -name "*.webp" \) -printf "%f\n" | sort)
    
    if [ ${#AVAILABLE_WALLPAPERS[@]} -eq 0 ]; then
        echo "Error: No image files found in $WALLPAPER_DIR"
        exit 1
    fi
    
    if command -v fzf &>/dev/null; then
        export FZF_WP_DIR="$WALLPAPER_DIR"
        WP_NAME=$(printf "%s\n" "${AVAILABLE_WALLPAPERS[@]}" | fzf \
            --ansi \
            --prompt="Select Wallpaper ($THEME) > " \
            --height=100% \
            --reverse \
            --preview-window="right:65%:wrap" \
            --preview='wallpaper-preview "$FZF_WP_DIR/{}"')
    elif command -v gum &>/dev/null; then
        WP_NAME=$(gum choose "${AVAILABLE_WALLPAPERS[@]}" --header "Select Wallpaper for $THEME:" --height 14)
    else
        echo "Select a wallpaper for $THEME:"
        select opt in "${AVAILABLE_WALLPAPERS[@]}"; do
            WP_NAME="$opt"
            break
        done
    fi
    
    if [ -z "$WP_NAME" ]; then
        echo "No wallpaper selected."
        exit 0
    fi
    
    WALLPAPER="$WALLPAPER_DIR/$WP_NAME"
    apply_wallpaper "$WALLPAPER" "$THEME"
    echo "$WALLPAPER" > "$HOME/.config/current-wallpaper-$THEME"
    echo "==> Successfully switched wallpaper to $WP_NAME!"
    exit 0
fi

mapfile -t AVAILABLE_THEMES < <(find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf "%f\n" | sort)

if [ ${#AVAILABLE_THEMES[@]} -eq 0 ]; then
    echo "Error: No themes found in $THEMES_DIR"
    exit 1
fi

THEME="${1:-}"
if [ -z "$THEME" ]; then
    if command -v fzf &>/dev/null; then
        export FZF_THEMES_DIR="$THEMES_DIR"
        THEME=$(printf "%s\n" "${AVAILABLE_THEMES[@]}" | fzf \
            --ansi \
            --prompt="Select System Theme > " \
            --height=100% \
            --reverse \
            --preview-window="right:65%:wrap" \
            --preview='wallpaper-preview "$FZF_THEMES_DIR/{}"')
    elif command -v gum &>/dev/null; then
        THEME=$(gum choose "${AVAILABLE_THEMES[@]}" --header "Select System Theme:" --height 14)
    else
        echo "Select a theme:"
        select opt in "${AVAILABLE_THEMES[@]}"; do
            THEME="$opt"
            break
        done
    fi
fi

if [ -z "$THEME" ]; then
    echo "No theme selected."
    exit 0
fi

SELECTED_DIR="$THEMES_DIR/$THEME"
if [ ! -d "$SELECTED_DIR" ]; then
    echo "Error: Theme '$THEME' does not exist in $THEMES_DIR"
    exit 1
fi

# Validate the requested image before changing any app configs or remembered state.
REQUESTED_WALLPAPER=''
if [ -n "${2:-}" ]; then
    REQUESTED_WALLPAPER=$(resolve_wallpaper "$SELECTED_DIR" "$2") || exit 1
fi

echo "==> Applying theme: $THEME"

if [ -f "$SELECTED_DIR/alacritty.toml" ]; then
    mkdir -p "$HOME/.config/alacritty"
    cp "$SELECTED_DIR/alacritty.toml" "$HOME/.config/alacritty/theme.toml"
fi

if [ -f "$SELECTED_DIR/tmux.conf" ]; then
    mkdir -p "$HOME/.config/tmux"
    cp "$SELECTED_DIR/tmux.conf" "$HOME/.config/tmux/theme.conf"
    # Reload tmux live if running
    if command -v tmux &>/dev/null && tmux info &>/dev/null; then
        tmux source-file "$HOME/.config/tmux/tmux.conf" 2>/dev/null || true
    fi
fi

if [ -f "$SELECTED_DIR/wezterm.lua" ]; then
    mkdir -p "$HOME/.config/wezterm"
    cp "$SELECTED_DIR/wezterm.lua" "$HOME/.config/wezterm/theme.lua"
fi

if [ -f "$SELECTED_DIR/kitty.conf" ]; then
    mkdir -p "$HOME/.config/kitty"
    cp "$SELECTED_DIR/kitty.conf" "$HOME/.config/kitty/theme.conf"
    if pgrep -x kitty &>/dev/null; then
        kitten @ --to=unix:@mykitty set-colors --all "$HOME/.config/kitty/theme.conf" 2>/dev/null || true
    fi
fi

if [ -f "$SELECTED_DIR/zellij.kdl" ]; then
    mkdir -p "$HOME/.config/zellij/themes"
    cp "$SELECTED_DIR/zellij.kdl" "$HOME/.config/zellij/themes/$THEME.kdl"
    if [ -f "$HOME/.config/zellij/config.kdl" ]; then
        sed -i "s/^theme \".*\"/theme \"$THEME\"/" "$HOME/.config/zellij/config.kdl"
    fi
fi

if [ -f "$SELECTED_DIR/neovim.lua" ]; then
    mkdir -p "$HOME/.config/nvim/lua/plugins"
    cp "$SELECTED_DIR/neovim.lua" "$HOME/.config/nvim/lua/plugins/theme.lua"
fi

if [ -f "$SELECTED_DIR/btop.theme" ]; then
    mkdir -p "$HOME/.config/btop/themes"
    cp "$SELECTED_DIR/btop.theme" "$HOME/.config/btop/themes/$THEME.theme"
    if [ -f "$HOME/.config/btop/btop.conf" ]; then
        sed -i "s/^color_theme = .*/color_theme = \"$THEME\"/" "$HOME/.config/btop/btop.conf"
    fi
fi

if [ -f "$SELECTED_DIR/yazi.toml" ]; then
    mkdir -p "$HOME/.config/yazi"
    cp "$SELECTED_DIR/yazi.toml" "$HOME/.config/yazi/theme.toml"
fi

if [ -f "$SELECTED_DIR/swaync.css" ]; then
    mkdir -p "$HOME/.config/swaync"
    cp "$SELECTED_DIR/swaync.css" "$HOME/.config/swaync/theme.css"
    if pgrep -x swaync &>/dev/null; then
        swaync-client -rs 2>/dev/null || true
    fi
fi

if [ -f "$SELECTED_DIR/wofi.css" ]; then
    mkdir -p "$HOME/.config/wofi"
    cp "$SELECTED_DIR/wofi.css" "$HOME/.config/wofi/theme.css"
fi

if [ -f "$SELECTED_DIR/hyprlock.conf" ]; then
    mkdir -p "$HOME/.config/hypr"
    cp "$SELECTED_DIR/hyprlock.conf" "$HOME/.config/hypr/hyprlock.conf"
fi

if [ -f "$SELECTED_DIR/waybar.css" ]; then
    mkdir -p "$HOME/.config/waybar"
    cp "$SELECTED_DIR/waybar.css" "$HOME/.config/waybar/theme.css"
    if command -v killall &>/dev/null; then
        killall -SIGUSR2 waybar 2>/dev/null || true
    fi
fi



WALLPAPER="$REQUESTED_WALLPAPER"
if [ -z "$WALLPAPER" ] && [ -f "$HOME/.config/current-wallpaper-$THEME" ]; then
    SAVED_WP=$(cat "$HOME/.config/current-wallpaper-$THEME")
    if [ -f "$SAVED_WP" ]; then
        WALLPAPER="$SAVED_WP"
    fi
fi

if [ -z "$WALLPAPER" ] && [ -d "$SELECTED_DIR/wallpapers" ]; then
    WALLPAPER=$(find "$SELECTED_DIR/wallpapers" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.jpeg" -o -name "*.webp" \) | sort | head -n 1)
fi

if [ -z "$WALLPAPER" ]; then
    WALLPAPER=$(find "$SELECTED_DIR" -maxdepth 1 -name "background.*" | head -n 1)
fi

apply_wallpaper "$WALLPAPER" "$THEME"

mkdir -p "$HOME/.config"
echo "$THEME" > "$HOME/.config/current-theme"
if [ -n "$WALLPAPER" ]; then
    echo "$WALLPAPER" > "$HOME/.config/current-wallpaper-$THEME"
fi

echo "==> Successfully switched to $THEME!"
