# Disable WezTerm shell integration when outside WezTerm or inside Neovim
if [[ -n "$NVIM" || -z "$WEZTERM_PANE" ]]; then
    export WEZTERM_SHELL_SKIP_ALL=1
fi

# Editor used by CLI
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"

# Ensure ~/.local/bin is in PATH
export PATH="$HOME/.local/bin:$PATH"

# Theme & Font switcher shortcuts
alias theme="theme-switch"
alias font="font-switch"

