# --- Editor ---
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"

# --- PATH ---
export PATH="$HOME/.local/bin:$PATH"

# --- Zsh Basics (History, Completion, Keybindings) ---
# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# Completion — only rescan once per day; use cached dump otherwise (~150ms saved)
autoload -Uz compinit
if [[ -f ~/.zcompdump && $(date +%j) == $(date -r ~/.zcompdump +%j 2>/dev/null) ]]; then
    compinit -C  # use cache, skip security check
else
    compinit     # full rescan + regenerate cache
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Keybindings
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# Colors for standard commands
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ll='ls -lh'
alias la='ls -lha'

# --- Plugins ---
local plugin_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

if [ -f "$plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    source "$plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if [ -f "$plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    source "$plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Enable fzf keybindings and fuzzy completion
if command -v fzf &> /dev/null; then
    source <(fzf --zsh 2>/dev/null || echo "")
fi

# --- Starship Prompt ---
if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

# --- Zoxide (Smarter cd) ---
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# --- Machine-local environment variables (API keys, tokens, private URLs) ---
# This file is NOT tracked by git. Create ~/.zshrc.local on each machine.
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# --- Yazi: change directory on exit ---
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# --- Aliases ---
alias theme="theme-switch"
